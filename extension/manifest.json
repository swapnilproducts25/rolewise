{
  "manifest_version": 3,
  "name": "Rolewise Fill",
  "version": "0.6.0",
  "description": "Fills job application forms from your Rolewise kits (CV, cover letter, answers), including LinkedIn Easy Apply step by step. You review and click Submit yourself.",
  "content_scripts": [
    {
      "matches": [
        "https://*.homerun.co/*",
        "https://*.myworkday.com/*",
        "https://*.myworkdayjobs.com/*",
        "https://apply.workable.com/*",
        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://jobs.ashbyhq.com/*",
        "https://jobs.lever.co/*",
        "https://jobs.smartrecruiters.com/*",
        "https://www.linkedin.com/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://job-boards.greenhouse.io/*",
        "https://boards.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://jobs.ashbyhq.com/*",
        "https://apply.workable.com/*",
        "https://jobs.smartrecruiters.com/*",
        "https://*.homerun.co/*"
      ],
      "js": [
        "page.js"
      ],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "kits/*",
        "kits/files/*/*"
      ],
      "matches": [
        "https://*.homerun.co/*",
        "https://*.myworkday.com/*",
        "https://*.myworkdayjobs.com/*",
        "https://apply.workable.com/*",
        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://jobs.ashbyhq.com/*",
        "https://jobs.lever.co/*",
        "https://jobs.smartrecruiters.com/*",
        "https://www.linkedin.com/*"
      ]
    }
  ],
  "action": {
    "default_title": "Rolewise Fill: your Ready jobs",
    "default_popup": "popup.html"
  },
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "host_permissions": [
    "https://api.anthropic.com/*"
  ]
}
